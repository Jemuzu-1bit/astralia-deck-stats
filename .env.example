# Required server-only variables for the Vercel deployment.
# Use a Redis TCP/TLS endpoint with EVAL and Pub/Sub, not a REST URL.
REDIS_URL=rediss://default:REPLACE_ME@YOUR_REDIS_HOST:6379
REDIS_KEY_PREFIX=astralia:production

# Optional for integration tests against an isolated namespace in a real Redis.
# TEST_REDIS_URL=redis://127.0.0.1:6379

# Public Supabase values for the Vite client. Set these in Vercel for Production
# and Preview, and in client/.env.local for local development.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional: point card images to a Cloudflare custom domain after copying the
# current public/cards tree to R2. Omit /cards from the base URL.
# VITE_CARD_IMAGE_BASE_URL=https://cards.example.com
