# Optional for local development with a separately hosted backend.
# Leave VITE_SERVER_URL unset on Vercel; the backend is on the same origin.
# VITE_SERVER_URL=https://your-game-server.example.com

# Local/standalone default: /socket.io
# npm run build:vercel sets /api/game/socket.io automatically.
# VITE_SOCKET_PATH=/socket.io
